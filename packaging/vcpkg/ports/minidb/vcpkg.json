{
  "name": "minidb",
  "version": "1.0.1",
  "description": "Embedded C++ database engine (in-process, no server) built on this project's own allocator, container, concurrency, and JSON libraries.",
  "homepage": "https://github.com/privateMwb/MiniDatabase",
  "license": "MIT",
  "dependencies": [
    "vcpkg-cmake",
    "vcpkg-cmake-config",
    {
      "name": "vectorpro",
      "version>=": "1.0.0"
    },
    {
      "name": "jsonpro",
      "version>=": "1.0.0"
    },
    {
      "name": "poolpro",
      "version>=": "1.0.0"
    },
    {
      "name": "hashmappro",
      "version>=": "1.0.0"
    },
    {
      "name": "cachepro",
      "version>=": "1.0.0"
    },
    {
      "name": "arenapro",
      "version>=": "1.0.0"
    },
    {
      "name": "threadpoolpro",
      "version>=": "1.0.0"
    }
  ]
}
